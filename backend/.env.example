
# Sistema de Soporte TI - Grocio Prado
# Plantilla de configuracion del backend

# Entorno de ejecucion
APP_ENV=development

# Proyecto Supabase
SUPABASE_URL=

# Conexion privada a PostgreSQL
DATABASE_URL=

# Direccion del frontend
FRONTEND_URL=http://localhost:5173

# Administración 111A: privadas, solo en el servidor. No usar prefijo VITE_.
# Mantener false hasta validar y aplicar manualmente 04_administracion_perfiles.sql.
ADMINISTRACION_PERFILES_HABILITADA=false
SUPABASE_SERVICE_ROLE_KEY=
# Confirmación del operador tras configurar y probar SMTP en Supabase Auth.
SUPABASE_SMTP_CONFIGURADO=false

# 112E: valores de ejemplo VACÍOS. No habilitar hasta pruebas/configuración privada.
BREVO_HABILITADO=false
BREVO_API_KEY=
CORREO_REMITENTE=
ADJUNTOS_HABILITADOS=false
ADJUNTOS_BUCKET=
